# Server only. Never prefix secrets with VITE_.
PORT=3001
WEB_ORIGIN=http://localhost:5173
WORLD_ID=hello-neighborhood
# Set a strong private key to enable remote Director controls.
DIRECTOR_KEY=
# Development only: enables Director from same-origin loopback connections.
ALLOW_LOCAL_DIRECTOR=true
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:5173/api/twitch/callback
# JSON object of approved Twitch reward ID -> wave|dance|confetti|weather presets; see docs/TWITCH.md.
TWITCH_REWARD_ACTIONS=
TWITCH_BROADCASTER_ID=
TWITCH_BROADCASTER_NAME=
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=
# Leave blank. Use same-origin hosting/reverse proxy; arbitrary cross-origin API URLs are not supported.
VITE_SERVER_URL=

# Hosted Sites runtime (configure through Sites secrets, never in a VITE_ variable):
# TWITCH_REDIRECT_URI=https://hello-world-miles-society.myles4miles.chatgpt.site/api/twitch/callback
TWITCH_EVENTSUB_CALLBACK=https://hello-world-miles-events.myles4miles.chatgpt.site/api/twitch/eventsub
TWITCH_WEBHOOK_SECRET=
TWITCH_TOKEN_ENCRYPTION_KEY=
# Relay Site only; service access to its fixed upstream.
PRIVATE_SITE_SERVICE_TOKEN=
# Hosted Director: exact trusted Sites sign-in email of the world owner.
# Configure server-side; never grant controls based only on having signed in.
DIRECTOR_OWNER_EMAIL=
