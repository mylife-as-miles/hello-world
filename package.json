{
  "name": "hello-world",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "pnpm --parallel --filter @hello-world/server --filter @hello-world/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "start": "pnpm --filter @hello-world/server start",
    "test:browser": "node tests/browser-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "^1.64.1",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
